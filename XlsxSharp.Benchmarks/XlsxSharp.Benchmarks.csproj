<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>annotations</Nullable>
    <!-- ClosedXML pins SixLabors.Fonts <3.0.0; we force 3.1.0 to match XlsxSharp's requirement. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- Required by the NPOI package build target; see https://github.com/nissl-lab/npoi/blob/master/OSMF.md -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="[3.5.1,4.0.0)" />
    <PackageReference Include="EPPlus" Version="8.7.0" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- ClosedXML pins SixLabors.Fonts <3.0.0, XlsxSharp needs >=3.1.0; force the higher one. -->
    <PackageReference Include="SixLabors.Fonts" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XlsxSharp\XlsxSharp.csproj" />
  </ItemGroup>
</Project>
