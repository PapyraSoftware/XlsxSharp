<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1605;CS1591;CS1658;CS1584;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.xlsx" Exclude="**\~$*.xlsx;bin\**" />
    <EmbeddedResource Include="**\*.xlsm" Exclude="**\~$*.xlsm;bin\**" />
    <EmbeddedResource Include="**\*.xltx" Exclude="**\~$*.xltx;bin\**" />
    <EmbeddedResource Include="**\*.xltm" Exclude="**\~$*.xltm;bin\**" />
    <EmbeddedResource Include="Resource\Images\**\*.*" />
    <EmbeddedResource Include="Resource\Fonts\*.*" />
    <EmbeddedResource Include="Resource\Other\**\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.65.51" />
    <!-- Several tests check XlsxSharp's own OOXML reading/writing against the reference SDK
         directly - EnumConverter (Utils/EnumConverter.cs) chief among them, an enum-mapping test
         oracle that used to live in XlsxSharp itself before that dependency was removed there. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="[3.5.1,4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XlsxSharp.ExcelNumberFormat\XlsxSharp.ExcelNumberFormat.csproj" />
    <ProjectReference Include="..\XlsxSharp.Parser\XlsxSharp.Parser.csproj" />
    <ProjectReference Include="..\XlsxSharp\XlsxSharp.csproj" />
    <!-- XlsxSharp references this privately so it can be packed into the XlsxSharp package, which
         means it no longer flows through transitively. The IO tests need it directly. -->
    <ProjectReference Include="..\XlsxSharp.IO\XlsxSharp.IO.csproj" />
    <!-- Same story for the parser: the formula and reference tests use its types directly. -->
    <ProjectReference Include="..\XlsxSharp.Examples\XlsxSharp.Examples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom global usings added in the csproj file -->
    <Using Include="TUnit.Core" />
    <Using Include="TUnit.Core.Executors" />
    <Using Include="TUnit.Assertions" />
    <Using Include="TUnit.Assertions.Extensions" />
    <Using Include="XlsxSharp.Tests.Utils" />
  </ItemGroup>
</Project>
