    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XlsxSharp.Parser.Tests" />
    <InternalsVisibleTo Include="XlsxSharp.Benchmarks" />
  </ItemGroup>
</Project>
