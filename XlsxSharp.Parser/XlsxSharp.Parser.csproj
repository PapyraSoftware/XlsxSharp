  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Lexer isn't CLS compliant thus neither should be the assembly.  -->
