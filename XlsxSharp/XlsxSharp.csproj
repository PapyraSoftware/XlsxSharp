<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1605;CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Bold.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-BoldItalic.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Italic.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Regular.ttf" />
    <EmbeddedResource Include="Excel\IO\OfficeTheme.xml" />
    <!-- The OOXML/OPC schemas SaveOptions.ValidatePackage validates against - see
         Excel\IO\Schemas\PROVENANCE.md for what these are and where they come from. -->
    <EmbeddedResource Include="Excel\IO\Schemas\*.xsd" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Include="..\resources\logo\nuget-logo.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="Excel\IO\Schemas\PROVENANCE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RBush.Signed" Version="4.0.0" />
    <PackageReference Include="SixLabors.Fonts" Version="3.1.0" />
  </ItemGroup>

  <!-- XlsxSharp.IO ships inside this package rather than as a package of its own. PrivateAssets
       keeps it out of the nuspec dependencies, IncludeXlsxSharpIoInPackage puts its assembly next
       to XlsxSharp.dll in lib/ so consumers still resolve the types it exposes. -->
  <ItemGroup>
    <ProjectReference
      Include="..\XlsxSharp.ExcelNumberFormat\XlsxSharp.ExcelNumberFormat.csproj"
      PrivateAssets="all"
    />
    <ProjectReference Include="..\XlsxSharp.IO\XlsxSharp.IO.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- The formula parser used to come from the ClosedXML.Parser package. Its sources now live in
       XlsxSharp.Parser/, imported with their full upstream history, so that we can profile and
       optimise them in place. It ships the same way XlsxSharp.IO does: referenced as a project,
       kept out of the nuspec dependencies, and copied into lib/ next to XlsxSharp.dll. -->
  <ItemGroup>
    <ProjectReference Include="..\XlsxSharp.Parser\XlsxSharp.Parser.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeXlsxSharpIoInPackage;IncludeParserInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeXlsxSharpIoInPackage">
    <!-- Taken from the output directory rather than from ReferenceCopyLocalPaths, so that packing
         works whether or not pack rebuilds first. Documentation and symbols are optional, the
         assembly is not. -->
    <ItemGroup>
      <_XlsxSharpIoOutput Include="$(OutputPath)XlsxSharp.IO.dll;$(OutputPath)XlsxSharp.IO.xml;$(OutputPath)XlsxSharp.IO.pdb" />
    </ItemGroup>

    <Error
      Condition="!Exists('$(OutputPath)XlsxSharp.IO.dll')"
      Text="XlsxSharp.IO.dll was not found in $(OutputPath). It has to be packed into the XlsxSharp package, so build the project before packing it."
    />

    <ItemGroup>
      <BuildOutputInPackage Include="@(_XlsxSharpIoOutput)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeParserInPackage">
    <!-- Same approach as IncludeXlsxSharpIoInPackage above: read the copy that landed in the output
         directory, so packing does not depend on which target framework of the multi-targeted
         parser was selected. -->
    <ItemGroup>
      <_ParserOutput Include="$(OutputPath)XlsxSharp.Parser.dll;$(OutputPath)XlsxSharp.Parser.xml;$(OutputPath)XlsxSharp.Parser.pdb" />
    </ItemGroup>

    <Error
      Condition="!Exists('$(OutputPath)XlsxSharp.Parser.dll')"
      Text="XlsxSharp.Parser.dll was not found in $(OutputPath). It has to be packed into the XlsxSharp package, so build the project before packing it."
    />

    <ItemGroup>
      <BuildOutputInPackage Include="@(_ParserOutput)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
